SPRING_PROFILES_ACTIVE=dev # Selecciona la configuración de desarrollo del backend ejecutable.
DB_NAME=somphie # Nombra la base que PostgreSQL crea al inicializar el volumen.
DB_URL=jdbc:postgresql://localhost:5432/somphie # Conecta una aplicación ejecutada en el host a Compose.
DB_USER=somphie # Usuario local compartido por PostgreSQL y el backend.
DB_PASSWORD=change-me-local-only # Contraseña ficticia exclusiva del entorno de desarrollo.
JWT_SECRET=REPLACE_WITH_BASE64_32_RANDOM_BYTES # Generar una clave Base64 de al menos 256 bits; nunca versionar la real.
DEMO_STAFF_PASSWORD=demo-only-password # Solo dev/demo; reemplazala fuera del entorno local.
WEB_BASE_URL=http://localhost:5173 # Origen local previsto para generar enlaces de QR.
CORS_ALLOWED_ORIGINS=http://localhost:5173 # Limita CORS al cliente local durante el desarrollo.
MAIL_HOST=localhost # Envía correo de prueba a Mailpit desde procesos del host.
MAIL_PORT=1025 # Usa el puerto SMTP local de Mailpit.
DEMO_MODE=true # Habilita comportamientos y datos ficticios solo para desarrollo/demo.
VITE_API_BASE_URL=http://localhost:8080/api/v1 # URL local que usará la web al implementarse.
